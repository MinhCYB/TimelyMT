{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:timelymt:schema:parsed-transcript:1.0.0",
  "title": "TimelyMT Parsed Monolingual Transcript",
  "description": "Provider-neutral intermediate representation of one language of one talk before bilingual alignment and timing completion.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "talk_id",
    "language",
    "provider",
    "segmentation",
    "segments",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "talk_id": {
      "$ref": "#/$defs/identifier"
    },
    "language": {
      "enum": ["en", "vi"]
    },
    "provider": {
      "type": "string",
      "minLength": 1
    },
    "segmentation": {
      "$ref": "#/$defs/segmentation"
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/segment"
      }
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "nullableMilliseconds": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "segmentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method"],
      "properties": {
        "method": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "segment_id",
        "index",
        "text",
        "start_ms",
        "end_ms",
        "timing_source"
      ],
      "properties": {
        "segment_id": {
          "type": "string",
          "pattern": "^(en|vi)-[0-9]{6}$"
        },
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "start_ms": {
          "$ref": "#/$defs/nullableMilliseconds"
        },
        "end_ms": {
          "$ref": "#/$defs/nullableMilliseconds"
        },
        "timing_source": {
          "enum": [
            "none",
            "wit3_seekvideo",
            "original_caption",
            "other"
          ]
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_input_path",
        "source_checksum_sha256",
        "parser_name",
        "parser_version",
        "processed_at"
      ],
      "properties": {
        "raw_input_path": {
          "type": "string",
          "minLength": 1
        },
        "source_checksum_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "parser_name": {
          "type": "string",
          "minLength": 1
        },
        "parser_version": {
          "type": "string",
          "minLength": 1
        },
        "processed_at": {
          "type": "string",
          "format": "date-time"
        },
        "source_metadata": {
          "type": "object",
          "additionalProperties": true
        }
      }
    }
  }
}
