{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:timelymt:schema:aligned-transcript:1.0.0",
  "title": "TimelyMT Aligned Bilingual Transcript",
  "description": "Intermediate monotonic alignment between independently parsed English and Vietnamese transcripts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "talk_id",
    "source_language",
    "target_language",
    "source_artifact",
    "target_artifact",
    "method",
    "alignments",
    "unaligned_source_segment_ids",
    "unaligned_target_segment_ids",
    "statistics",
    "provenance"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "talk_id": {"$ref": "#/$defs/identifier"},
    "source_language": {"const": "en"},
    "target_language": {"const": "vi"},
    "source_artifact": {"type": "string", "minLength": 1},
    "target_artifact": {"type": "string", "minLength": 1},
    "method": {"$ref": "#/$defs/method"},
    "alignments": {
      "type": "array",
      "items": {"$ref": "#/$defs/alignment"}
    },
    "unaligned_source_segment_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/identifier"}
    },
    "unaligned_target_segment_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/identifier"}
    },
    "statistics": {"$ref": "#/$defs/statistics"},
    "provenance": {"$ref": "#/$defs/provenance"}
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "parameters"],
      "properties": {
        "name": {"const": "monotonic_length_position_dp"},
        "version": {"type": "string", "minLength": 1},
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_group_size", "skip_penalty"],
          "properties": {
            "max_group_size": {"type": "integer", "minimum": 1, "maximum": 3},
            "skip_penalty": {"type": "number", "exclusiveMinimum": 0}
          }
        }
      }
    },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "length_cost",
        "position_cost",
        "timing_cost",
        "group_penalty",
        "annotation_penalty",
        "source_normalized_length",
        "target_normalized_length",
        "expected_target_source_ratio"
      ],
      "properties": {
        "length_cost": {"type": "number", "minimum": 0},
        "position_cost": {"type": "number", "minimum": 0},
        "timing_cost": {"oneOf": [{"type": "number", "minimum": 0}, {"type": "null"}]},
        "group_penalty": {"type": "number", "minimum": 0},
        "annotation_penalty": {"type": "number", "minimum": 0},
        "source_normalized_length": {"type": "integer", "minimum": 0},
        "target_normalized_length": {"type": "integer", "minimum": 0},
        "expected_target_source_ratio": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "alignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "alignment_id",
        "source_segment_ids",
        "target_segment_ids",
        "source_text",
        "target_text",
        "score",
        "features"
      ],
      "properties": {
        "alignment_id": {"type": "string", "pattern": "^a-[0-9]{6}$"},
        "source_segment_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        },
        "target_segment_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        },
        "source_text": {"type": "string", "minLength": 1},
        "target_text": {"type": "string", "minLength": 1},
        "score": {"type": "number", "minimum": 0},
        "features": {"$ref": "#/$defs/features"}
      }
    },
    "typeCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["1:1", "1:2", "2:1", "2:2", "1:3", "3:1", "other"],
      "properties": {
        "1:1": {"type": "integer", "minimum": 0},
        "1:2": {"type": "integer", "minimum": 0},
        "2:1": {"type": "integer", "minimum": 0},
        "2:2": {"type": "integer", "minimum": 0},
        "1:3": {"type": "integer", "minimum": 0},
        "3:1": {"type": "integer", "minimum": 0},
        "other": {"type": "integer", "minimum": 0}
      }
    },
    "statistics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_segment_count",
        "target_segment_count",
        "alignment_unit_count",
        "alignment_type_counts",
        "unaligned_source_count",
        "unaligned_target_count",
        "mean_score",
        "median_score",
        "minimum_score",
        "maximum_score"
      ],
      "properties": {
        "source_segment_count": {"type": "integer", "minimum": 1},
        "target_segment_count": {"type": "integer", "minimum": 1},
        "alignment_unit_count": {"type": "integer", "minimum": 0},
        "alignment_type_counts": {"$ref": "#/$defs/typeCounts"},
        "unaligned_source_count": {"type": "integer", "minimum": 0},
        "unaligned_target_count": {"type": "integer", "minimum": 0},
        "mean_score": {"oneOf": [{"type": "number", "minimum": 0}, {"type": "null"}]},
        "median_score": {"oneOf": [{"type": "number", "minimum": 0}, {"type": "null"}]},
        "minimum_score": {"oneOf": [{"type": "number", "minimum": 0}, {"type": "null"}]},
        "maximum_score": {"oneOf": [{"type": "number", "minimum": 0}, {"type": "null"}]}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_checksum_sha256", "target_checksum_sha256", "processed_at"],
      "properties": {
        "source_checksum_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "target_checksum_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "processed_at": {"type": "string", "format": "date-time"}
      }
    }
  }
}
