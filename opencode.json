{
  "$schema": "https://opencode.ai/config.json",
  "model": "cyboj-9router/cx/gpt-5.6-sol",
  "provider": {
    "cyboj-9router": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "pnq 9Router",
      "options": {
        "baseURL": "https://9router.pnqua.ng/v1"
      },
      "models": {
        "cx/gpt-5.6-luna": {
          "name": "GPT-5.6 Luna",
          "limit": {
            "context": 192000,
            "output": 64000
          }
        },
        "cx/gpt-5.6-terra": {
          "name": "GPT-5.6 Terra",
          "limit": {
            "context": 270000,
            "output": 96000
          }
        },
        "cx/gpt-5.6-sol": {
          "name": "GPT-5.6 Sol",
          "limit": {
            "context": 270000,
            "output": 96000
          }
        },
        "prod": {
          "name": "Production",
          "limit": {
            "context": 192000,
            "output": 64000
          }
        },
        "stronk": {
          "name": "Stronk",
          "limit": {
            "context": 192000,
            "output": 64000
          }
        },
        "mid": {
          "name": "Mid",
          "limit": {
            "context": 192000,
            "output": 64000
          }
        },
        "noob": {
          "name": "Noob",
          "limit": {
            "context": 192000,
            "output": 64000
          }
        }
      }
    }
  },
  "mcp": {
    "serena": {
      "type": "local",
      "command": [
        "C:\\Users\\Admin\\.local\\bin\\serena.exe",
        "start-mcp-server",
        "--context=ide",
        "--project-from-cwd",
        "--open-web-dashboard",
        "false"
      ],
      "cwd": ".",
      "enabled": true,
      "timeout": 180000
    }
  },
  "lsp": true,
  "formatter": true,
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 16000
  },
  "watcher": {
    "ignore": [
      "node_modules/**",
      ".next/**",
      "dist/**",
      "build/**",
      "coverage/**",
      ".git/**",
      ".playwright-cli/**",
      "artifacts/ui-review/**",
      "**/__pycache__/**",
      "**/.pytest_cache/**",
      ".serena/cache/**",
      ".serena/logs/**"
    ]
  },
  "agent": {
    "build": {
      "permission": {
        "task": {
          "*": "deny",
          "code-reviewer": "allow",
          "test-verifier": "allow"
        }
      }
    }
  },
  "permission": {
    "*": "allow",
    "serena_execute_shell_command": "deny",
    "bash": {
      "*": "allow",
      "git commit*": "deny",
      "git push*": "deny",
      "git reset*": "deny",
      "git clean*": "deny",
      "git restore*": "deny",
      "git checkout*": "deny",
      "git switch*": "deny",
      "git rebase*": "deny",
      "git merge*": "deny",
      "git cherry-pick*": "deny",
      "git revert*": "deny",
      "docker compose down -v*": "deny",
      "docker-compose down -v*": "deny"
    },
    "external_directory": "deny"
  }
}